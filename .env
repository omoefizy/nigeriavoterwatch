# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                  # development | staging | production
APP_SECRET_KEY=fb644ac57e73a4b31bd9f9584c04eced667d41ce63424eb050562a70886971d2
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
ADMIN_API_KEY=d2ae342eb7ee73b906f5c7b2b7d7362a2f47040fe65bf0778a15f20c5e9d9f41
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://nigeriavote_db_user:9eria%402027@nigeriavotewatch.gllpnva.mongodb.net/?appName=Nigeriavotewatch
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── INEC Scraping Targets ────────────────────────────────────────────────────
INEC_RESULTS_BASE_URL=https://results.inecnigeria.org
INEC_PORTAL_BASE_URL=https://inecnigeria.org
SCRAPER_USER_AGENT=NigeriaVoteWatch/1.0 (election integrity monitoring; contact@nigeriavoterwatch.ng)
SCRAPER_INTERVAL_SECONDS=300        # how often to poll INEC (seconds)
SCRAPER_CONCURRENCY=4

# ─── OCR ──────────────────────────────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract    # path to tesseract binary
OCR_LANGUAGE=eng
# Google Vision API — set this to enable Vision OCR fallback
GOOGLE_APPLICATION_CREDENTIALS=    # path to service account JSON
GOOGLE_CLOUD_PROJECT=

# ─── Storage ──────────────────────────────────────────────────────────────────
# Local storage (development)
UPLOAD_DIR=./uploads
# S3-compatible (production)
S3_BUCKET=nigeriavoterwatch-docs
S3_REGION=af-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=                    # leave blank for AWS; set for MinIO/Cloudflare R2

# ─── Authentication & JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=9d6a28191f4621795473c49b8d98dd9b5d535d5d781b4bc1c76d7768856e641a
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Observer Portal ──────────────────────────────────────────────────────────
OBSERVER_REPORT_RATE_LIMIT=10       # max reports per observer per hour
OBSERVER_INVITE_CODE_TTL_HOURS=48   # how long invite codes remain valid

# ─── Integrity & Hash Chain ───────────────────────────────────────────────────
HASH_ALGORITHM=sha256
GENESIS_BLOCK_SEED=NigeriaVoteWatch-genesis-2027
CHAIN_VERIFICATION_INTERVAL_MINUTES=15

# ─── Notifications ────────────────────────────────────────────────────────────
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@nigeriavoterwatch.ng

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=                         # leave blank to disable Sentry
LOG_LEVEL=INFO

# ─── CORS & Security ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY_HEADERS=false
